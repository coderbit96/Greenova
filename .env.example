# ─── Database ────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/greenova
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/greenova
MONGODB_URI=mongodb://127.0.0.1:27017/greenova

# ─── Auth (required) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── Google OAuth (optional) ─────────────────────────────────
# console.cloud.google.com > Credentials > OAuth client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Razorpay (optional) ─────────────────────────────────────
# Leave blank to use the built-in mock gateway for local testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Cloudinary (optional) ───────────────────────────────────
# Leave blank to use remote image URLs instead of uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
