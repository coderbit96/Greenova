# Copy this file to .env.local for local development. Do not commit .env.local.

# Database
# Local example: mongodb://127.0.0.1:27017/greenova
MONGODB_URI=

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public application URL, for example http://localhost:3000 or https://greenova.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Auth.js server URL; keep it equal to NEXT_PUBLIC_APP_URL.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# One-time administrator bootstrap (used only by `npm run create-admin`)
# Keep these private; never prefix them with NEXT_PUBLIC_.
GREENOVA_ADMIN_EMAIL=
GREENOVA_ADMIN_PASSWORD=

# Firebase Authentication (optional)
# Enable Email/Password in Firebase Console > Authentication.
# These values are intentionally public browser configuration, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK credentials: server only. Rotate any credential exposed
# outside your secret manager. Paste the private key as one line with \n escapes.
# Never use NEXT_PUBLIC_ for either of these values and never commit the JSON key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (optional; leave blank to use the local mock gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# This is Razorpay's publishable key id only. Never place a secret in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Uploads (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Hotel calendar (optional; defaults to Asia/Kolkata)
HOTEL_TIME_ZONE=Asia/Kolkata
